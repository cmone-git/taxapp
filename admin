                    </button>
                    <button class="flex flex-col items-center gap-2">
                        <div class="w-14 h-14 rounded-full bg-card-light dark:bg-card-dark border border-gray-100 dark:border-gray-800 shadow-sm flex items-center justify-center text-textMain-light dark:text-textMain-dark active:scale-95 transition-transform">
                            <i data-lucide="more-horizontal" class="w-6 h-6"></i>
                        </div>
                        <span class="text-xs font-medium">More</span>
                    </button>
                </div>

                <div class="flex justify-between items-center mb-4 px-2">
                    <h3 class="text-lg font-bold">Recent</h3>
                    <button class="text-sm font-medium bg-gray-200/50 dark:bg-gray-800/50 px-3 py-1 rounded-full text-textMain-light dark:text-textMain-dark">See all</button>
                </div>

                <div class="bg-card-light dark:bg-card-dark rounded-3xl p-2 shadow-sm border border-gray-100 dark:border-gray-800">
                    ${db.transactions.map((tx, index) => `
                        <div class="flex items-center justify-between p-4 ${index !== db.transactions.length -1 ? 'border-b border-gray-100 dark:border-gray-800/50' : ''}">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-full ${tx.type === 'in' ? 'bg-emerald-100 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400' : 'bg-primary/10 text-primary'} flex items-center justify-center shadow-inner">
                                    <i data-lucide="${tx.type === 'in' ? 'arrow-down-left' : 'arrow-up-right'}" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <h4 class="font-semibold text-base">${tx.entity}</h4>
                                    <p class="text-xs text-textSub-light dark:text-textSub-dark">${tx.date} • ${tx.status}</p>
                                </div>
                            </div>
                            <div class="font-bold text-lg ${tx.type === 'in' ? 'text-emerald-500' : 'text-primary'}">
                                ${tx.amount}
                            </div>
                        </div>
                    `).join('')}
                </div>
            `,
            
            menu: () => `
                <div class="mb-6">
                    <h2 class="text-3xl font-bold tracking-tight mb-1">More</h2>
                    <p class="text-textSub-light dark:text-textSub-dark text-sm">App settings & preferences</p>
                </div>
                
                <div class="bg-card-light dark:bg-card-dark rounded-3xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden mb-6">
                    <div class="p-4 flex items-center gap-4 border-b border-gray-100 dark:border-gray-800/50">
                        <div class="w-16 h-16 rounded-full bg-primary flex items-center justify-center text-white text-xl font-bold shadow-md shadow-primary/30">
                            ${currentUser && currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'JD'}
                        </div>
                        <div>
                            <h3 class="font-bold text-lg">${currentUser && currentUser.name ? currentUser.name : 'John Doe'}</h3>
                            <p class="text-textSub-light dark:text-textSub-dark text-sm">${currentUser && currentUser.clientId ? currentUser.clientId : 'Compliance Officer'}</p>
                        </div>
                    </div>
                    <div class="p-2">
                        <button class="w-full flex items-center justify-between p-3 rounded-2xl hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors text-left">
                            <div class="flex items-center gap-3">
                                <i data-lucide="user" class="w-5 h-5 text-gray-400"></i>
                                <span class="font-medium">Profile Settings</span>
                            </div>
                            <i data-lucide="chevron-right" class="w-4 h-4 text-gray-300"></i>
                        </button>
                        <button class="w-full flex items-center justify-between p-3 rounded-2xl hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors text-left">
                            <div class="flex items-center gap-3">
                                <i data-lucide="bell" class="w-5 h-5 text-gray-400"></i>
                                <span class="font-medium">Notifications</span>
                            </div>
                            <i data-lucide="chevron-right" class="w-4 h-4 text-gray-300"></i>
                        </button>
                    </div>
                </div>

                <div class="bg-card-light dark:bg-card-dark rounded-3xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden">
                    <div class="p-2">
                         <button onclick="location.reload()" class="w-full flex items-center justify-between p-3 rounded-2xl hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors text-left text-primary">
                            <div class="flex items-center gap-3">
                                <i data-lucide="log-out" class="w-5 h-5"></i>
                                <span class="font-medium">Log Out</span>
                            </div>
                        </button>
                    </div>
                </div>
            `
        };

        const mainContent = document.getElementById('main-content');
        const navItems = document.querySelectorAll('.nav-item');

        function renderView(viewName) {
            mainContent.innerHTML = views[viewName]();
            lucide.createIcons();
            
            navItems.forEach(item => {
                if (item.dataset.view === viewName) {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });
        }

        navItems.forEach(item => {
            item.addEventListener('click', () => {
                renderView(item.dataset.view);
            });
        });

        mainContent.addEventListener('click', (e) => {
            const calBtn = e.target.closest('.cal-date');
            if (calBtn) {
                const newDate = parseInt(calBtn.dataset.date);
                if (selectedDate !== newDate) {
                    selectedDate = newDate;
                    renderView('dashboard');
                }
            }
        });

        const themeBtn = document.getElementById('btn-theme');
        const html = document.documentElement;

        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            html.classList.add('dark');
        }

        themeBtn.addEventListener('click', () => {
            html.classList.toggle('dark');
        });

        
        // Decodes JWT token payload safely
        function decodeJwtResponse(token) {
            try {
                let base64Url = token.split('.')[1];
                let base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                let jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));
                return JSON.parse(jsonPayload);
            } catch (e) {
                return null;
            }
        }

        // The callback function executed after a successful Google Sign-in
        window.handleCredentialResponse = (response) => {
            const payload = decodeJwtResponse(response.credential);
            if (payload && payload.email) {
                verifyUserEmailWithBackend(payload.email);
            } else {
                showLoginError("Invalid Google login response.");
            }
        };

        // Initialize Google Sign-in API once window loads
        window.onload = function () {
            // Render initial icons
            lucide.createIcons();

            google.accounts.id.initialize({
                client_id: GOOGLE_CLIENT_ID,
                callback: handleCredentialResponse
            });
            
            google.accounts.id.renderButton(
                document.getElementById("google-btn-container"),
                { theme: "outline", size: "large", shape: "pill", width: 250, text: "signin_with" }
            );
        };

        // Event listener for manual form fallback (Admin Login)
        document.getElementById('btn-manual-login').addEventListener('click', () => {
            const emailInput = document.getElementById('admin-email').value;
            if (emailInput.trim() === '') {
                showLoginError("Please enter an email address.");
                return;
            }
            verifyUserEmailWithBackend(emailInput);
        });

        function showLoginError(msg) {
            const errEl = document.getElementById('login-error');
            errEl.textContent = msg;
            errEl.classList.remove('hidden');
        }

        // Verify the email against the Google Apps Script Backend (GET action=VERIFY_GOOGLE_LOGIN)
        async function verifyUserEmailWithBackend(email) {
            const btn = document.getElementById('btn-manual-login');
            const errEl = document.getElementById('login-error');
            
            // Set loading state
            btn.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i><span>Verifying...</span>';
            lucide.createIcons();
            errEl.classList.add('hidden');

            try {
                const url = `${APPS_SCRIPT_URL}?action=VERIFY_GOOGLE_LOGIN&email=${encodeURIComponent(email)}`;
                const response = await fetch(url);
                const data = await response.json();
                
                if (data.valid) {
                    // Login successful!
                    currentUser = data; // Save user data (Name, Client ID)
                    
                    // Update user initials in top header
                    document.getElementById('user-initial').textContent = data.name ? data.name.charAt(0).toUpperCase() : 'A';
                    
                    // Hide login screen, reveal app
                    document.getElementById('login-view').classList.add('hidden');
                    const appView = document.getElementById('app-view');
                    appView.classList.remove('hidden');
                    appView.classList.add('flex');
                    
                    // Initialize Dashboard
                    renderView('dashboard');
                } else {
                    // Login failed, email not found in sheet
                    showLoginError(data.message || "Email not registered in Clients sheet.");
                }
            } catch (error) {
                console.error("Auth Error:", error);
                showLoginError("Network error. Could not connect to backend.");
            } finally {
                // Reset button state
                btn.innerHTML = '<span>Continue</span><i data-lucide="arrow-right" class="w-4 h-4"></i>';
                lucide.createIcons();
            }
        }

    </script>
</body>
</html>
